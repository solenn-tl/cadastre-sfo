SELECT DISTINCT ?id ?label ?debut ?fin ?coords ?inseecomm ?ehess (GROUP_CONCAT(DISTINCT ?remplaceLabel; separator=",") AS ?remplace_)
WHERE {
  VALUES ?type { wd:Q484170 wd:Q18821702 }
  ?id p:P31 ?stmt .                 # the P31 statement
  ?stmt ps:P31 ?type .              # its value
  OPTIONAL { ?stmt pq:P580 ?debut . }   # qualifier: date de début
  OPTIONAL { ?stmt pq:P582 ?fin . }     # qualifier: date de fin
  OPTIONAL { ?id wdt:P8422 ?ehess. }
  OPTIONAL { ?id wdt:P625 ?coords. }
  OPTIONAL { ?id wdt:P374 ?inseecomm. }
  OPTIONAL { ?id wdt:P1365 ?remplace }
  ?id wdt:P131+ wd:Q3389 .
  ?id rdfs:label ?label . 
  FILTER(lang(?label) = "fr")
  FILTER(!BOUND(?fin) || YEAR(?fin) > 1807)
  FILTER(!BOUND(?debut) || YEAR(?debut) < 2000)
  SERVICE wikibase:label {
     bd:serviceParam wikibase:language "fr".
   }
}
GROUP BY ?id ?label ?debut ?fin ?coords ?inseecomm ?ehess 
ORDER BY ?label